<?xml version="1.0" encoding="utf-8" ?>
<!-- Fetches several URLs in parallel. Set `requests` ({name: url}), run it, and
     `results` arrives as {name: body}; a failed request gives "". A url can be
     backendUrl(...) (common.brs): one of the app's lists from the backend. -->
<component name="ApiTask" extends="Task">
  <interface>
    <field id="requests" type="assocarray" />
    <field id="results" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/generated/app_data.brs" />
  <script type="text/brightscript" uri="pkg:/source/backend.brs" />
  <script type="text/brightscript" uri="pkg:/source/backend_ppv.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/ApiTask.brs" />
</component>
