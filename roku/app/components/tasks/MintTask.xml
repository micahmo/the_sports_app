<?xml version="1.0" encoding="utf-8" ?>
<!-- A fresh link for a stream whose link stopped working, found in a new
     browser session while StreamTask keeps serving (see its playlist()). Set
     embedUrl + driver, run; `result` is {sid, url}, or {} if there's none. The
     session then belongs to StreamTask. Set `quit` to give up. With `probe`,
     only whether the stream works now: the session is closed, and `result`
     is {ok: true} or {} (PlayerScreen's watch for a stream to come back).
     `avoid`: a server whose links are passed over, unchecked, for another
     session, except on the last try. -->

<component name="MintTask" extends="Task">
  <interface>
    <field id="embedUrl" type="string" />
    <field id="driver" type="string" />
    <field id="probe" type="boolean" />
    <field id="avoid" type="string" />
    <field id="quit" type="boolean" alwaysNotify="true" />
    <field id="result" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/webdriver.brs" />
  <script type="text/brightscript" uri="pkg:/source/streamlink.brs" />
  <script type="text/brightscript" uri="pkg:/source/logtime.brs" />
  <script type="text/brightscript" uri="pkg:/source/generated/app_data.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/MintTask.brs" />
</component>
