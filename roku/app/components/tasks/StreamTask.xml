<?xml version="1.0" encoding="utf-8" ?>
<!-- Plays one stream: a browser session on the WebDriver server loads the
     embed page and fetches playlists (only a Chrome handshake gets them), and a
     small HTTP server on this Roku unwraps the TikTok-hosted segments. See
     DESIGN_NOTES.md, "Roku". Set embedUrl + driver, run; the Video node plays
     `streamUrl`. Set `quit` to stop and close the browser session. -->
<component name="StreamTask" extends="Task">
  <interface>
    <field id="embedUrl" type="string" />
    <field id="driver" type="string" />
    <field id="status" type="string" />
    <!-- Why it stopped: a message, "refused: <message>", "offline" (no
         internet) or "sitedown" (the stream site's pages don't answer). -->
    <field id="error" type="string" />
    <!-- The last try found the stream site down: look at it first, before a
         browser session (pageHostDown). -->
    <field id="siteWasDown" type="boolean" />
    <field id="streamUrl" type="string" />
    <field id="quit" type="boolean" alwaysNotify="true" />
    <!-- What's playing: {height, fps, mbps} (see measure()). -->
    <field id="quality" type="assocarray" />
    <!-- Seconds of video the player has been given so far. -->
    <field id="servedSecs" type="float" />
    <!-- Seconds of video downloaded that the player hasn't asked for yet (noteReady). -->
    <field id="readySecs" type="float" />
    <!-- The player is starting again: list only the newest few (longerWindow). -->
    <field id="trim" type="boolean" />
    <!-- How much of that list, from the top, the player has had (s): PlayerScreen
         skips it once the player plays. -->
    <field id="skipSecs" type="float" />
    <!-- Counts segments lost for good mid-stream (PlayerScreen's onLost). -->
    <field id="lost" type="integer" />
    <!-- Counts the player's starts again (PlayerScreen's restartAtLive): a
         segment still going to the one before is dropped (sendAll). -->
    <field id="startedAgain" type="integer" />
    <!-- The picture's clock just jumped this far ahead (s): big enough that the
         player starts again at live (PlayerScreen's onJumped). -->
    <field id="jumped" type="float" alwaysNotify="true" />
    <!-- A playlist came back with segments missed, this many seconds of them,
         short of a jump: PlayerScreen's onGap starts it again if it's paused
         at the edge anyway. -->
    <field id="gap" type="float" alwaysNotify="true" />
    <!-- Counts the player's requests, and each half second one is still being
         answered: PlayerScreen's quiet check (checkQuiet). -->
    <field id="asks" type="integer" />
    <!-- The last segment's length (s): a healthy player's requests come up to ~1.3 of it apart. -->
    <field id="segSecs" type="float" />
    <!-- Counts new links found mid-stream (PlayerScreen's onNewLink). -->
    <field id="newLink" type="integer" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/webdriver.brs" />
  <script type="text/brightscript" uri="pkg:/source/streamlink.brs" />
  <script type="text/brightscript" uri="pkg:/source/tsinfo.brs" />
  <script type="text/brightscript" uri="pkg:/source/logtime.brs" />
  <script type="text/brightscript" uri="pkg:/source/generated/app_data.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/StreamTask.brs" />
</component>
