<?xml version="1.0" encoding="utf-8" ?>
<!-- Holds a stack of screens: Back pops one (and on Home asks before exiting).
     Screens ask to open another by setting their `navigate` field. -->
<component name="MainScene" extends="Scene">
  <interface>
    <field id="driverStatus" type="string" />
    <field id="exitApp" type="boolean" alwaysNotify="true" />
    <!-- A newer release on GitHub, e.g. "1.0.81"; "" when this is the latest. -->
    <field id="newVersion" type="string" />
    <!-- "checking", "failed" or "done"; "" for a local build, which doesn't check. -->
    <field id="updateStatus" type="string" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/common.brs" />
  <script type="text/brightscript" uri="pkg:/source/generated/app_data.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <children>
    <!-- Keeps what's showing current; see onFreshTimer. -->
    <Timer id="freshTimer" duration="60" repeat="true" />
    <!-- The app tends to stay open on the TV, so look for a release hourly too. -->
    <Timer id="updateTimer" duration="3600" repeat="true" />
  </children>
</component>
