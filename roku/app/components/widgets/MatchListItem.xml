<?xml version="1.0" encoding="utf-8" ?>
<!-- MarkupList row: a MatchCard on a card background. Draws its own focus ring
     (the list's own focus bitmap lands outside the row); a grey ring marks the
     match whose streams are showing while the cursor is in the streams list.
     itemContent carries `match` and `sportName`. -->
<component name="MatchListItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" onChange="onSize" />
    <field id="height" type="float" onChange="onSize" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="listHasFocus" type="boolean" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/common.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/MatchListItem.brs" />
  <children>
    <Poster id="bg" uri="pkg:/images/card.9.png" />
    <MatchCard id="card" />
    <Poster id="ring" uri="pkg:/images/ring.9.png" visible="false" />
  </children>
</component>
